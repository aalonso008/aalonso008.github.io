  "exercises": [
    {
      "id": "ex_an32i925",
      "name": "Hammer Strength Iso-Lateral Incline Press",
      "muscleGroup": "Pecho",
      "muscles": [
        "Pecho clavicular",
        "Deltoides anterior",
        "Tríceps"
      ],
      "tip": "Tu movimiento principal. Cada brazo trabaja de forma independiente — sin compensación. Ajustá el asiento para que sientas el pecho superior, no el hombro. Descanso 2–2:30 min. El iso-lateral es superior a la barra para vos porque no fuerza el manguito rotador.",
      "linkUrl": "https://www.youtube.com/results?search_query=hammer+strength+iso+lateral+incline+press+technique",
      "linkLabel": "▶ Buscar técnica en YouTube",
      "archived": false,
      "updatedAt": "2026-09-28T22:32:04.676Z"
    },
    {
      "id": "ex_rgme3rdq",
      "name": "Hammer Strength Iso-Lateral Wide Chest",
      "muscleGroup": "Pecho",
      "muscles": [
        "Pecho clavicular (porción exterior)",
        "Deltoides anterior"
      ],
      "tip": "Ángulo más abierto que el Incline Press. Trabaja más la porción exterior del pecho superior. Rango de movimiento completo, dejá que el pecho estire bien en la bajada.",
      "linkUrl": "https://www.youtube.com/results?search_query=hammer+strength+iso+lateral+wide+chest+technique",
      "linkLabel": "▶ Buscar técnica en YouTube",
      "archived": false,
      "updatedAt": "2026-09-28T22:32:04.676Z"
    },
    {
      "id": "ex_69u8g0rh",
      "name": "Life Fitness Pectoral Fly",
      "muscleGroup": "Pecho",
      "muscles": [
        "Pecho esternal",
        "Pecho clavicular"
      ],
      "tip": "Llegás con el pecho prefatigado de los dos Hammer — lo vas a sentir mucho más con menos peso. Pausa 1 seg en la contracción (manos juntas). Bajada lenta y controlada, sin rebotar en el pecho abierto. Descanso 60–90 seg.",
      "linkUrl": "https://exrx.net/WeightExercises/PectoralSternal/MFly",
      "linkLabel": "▶ Ver técnica en ExRx",
      "archived": false,
      "updatedAt": "2026-09-28T22:32:04.676Z"
    },
    {
      "id": "ex_j5nfypa1",
      "name": "Hammer Strength Iso-Lateral Bench Press",
      "muscleGroup": "Pecho",
      "muscles": [
        "Pecho esternal",
        "Tríceps"
      ],
      "tip": "Pecho plano/medio para no descuidarlo. Al final del día cuando ya estás fatigado — no necesitás carga máxima acá. Rango completo, sin lock-out del codo arriba para mantener tensión.",
      "linkUrl": "https://www.youtube.com/results?search_query=hammer+strength+iso+lateral+bench+press+technique",
      "linkLabel": "▶ Buscar técnica en YouTube",
      "archived": false,
      "updatedAt": "2026-09-28T22:32:04.676Z"
    },
    {
      "id": "ex_yqpoo2qb",
